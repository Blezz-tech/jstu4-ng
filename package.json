{
  "name": "jstu4",
  "version": "3.0.0",
  "private": true,
  "description": "Interactive Turing machine emulator in 4-tuples (modern vanilla TypeScript rewrite)",
  "type": "module",
  "license": "MIT",
  "author": "Alexey Dubinin and jstu4 contributors",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:prod",
    "build:prod": "tsc --noEmit && vite build --mode production",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "shots": "SHOTS=1 playwright test e2e/visual.spec.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
